# Copy this file to .env.local and fill in your project's values.
# These Supabase values are public client configuration, not admin credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only AI credential. Never put it in the mobile environment.
GEMINI_API_KEY=your-gemini-api-key

# Optional Google Calendar integration, separate from Supabase Google sign-in.
# Register this origin + /api/auth/google/callback with the Google OAuth client.
NEXT_PUBLIC_APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Use a strong, stable random secret; otherwise GOOGLE_CLIENT_SECRET is used.
CALENDAR_TOKEN_SECRET=
