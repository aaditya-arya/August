{
  "name": "potvt",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "next dev",
    "dev:mobile": "npm run start --workspace @august/mobile",
    "android": "npm run android --workspace @august/mobile",
    "check:mobile": "npm run typecheck --workspace @august/mobile",
    "check:supabase": "node scripts/check-supabase.cjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsc -p tsconfig.test.json && tsc -p packages/shared/tsconfig.test.json && node --test tests/*.test.cjs",
    "test:ai": "tsc -p tsconfig.test.json && node tests/live-extraction.cjs",
    "repair:classifications": "tsc -p tsconfig.test.json && node scripts/repair-classifications.cjs",
    "test:taxonomy": "tsc -p tsconfig.test.json && node tests/live-taxonomy.cjs",
    "test:review": "tsc -p tsconfig.test.json && node tests/live-review.cjs"
  },
  "dependencies": {
    "@august/shared": "0.1.0",
    "@google/genai": "^2.23.0",
    "@supabase/supabase-js": "^2.116.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.47.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-force-graph-2d": "^1.29.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
